# KrishiMitra AI - Environment Variables Configuration

# -------------------------------------------------------------
# LLM Provider Configuration
# Options: bionic (default, Bionic OpenAI-compatible Local Model API), rule_engine, gemini, openai, ollama
# -------------------------------------------------------------
LLM_PROVIDER=bionic

# Bionic Local Model API Configuration (Required if LLM_PROVIDER=bionic)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
LLM_MAX_TOKENS=750
LLM_API_KEY=

# Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama Configuration (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -------------------------------------------------------------
# Weather API Configuration (Optional)
# Open-Meteo works globally without an API key. OpenWeatherMap can be added here.
# -------------------------------------------------------------
WEATHER_API_KEY=

# -------------------------------------------------------------
# Database & Vector Store Settings
# ---------------------------------------------
DATABASE_URL=sqlite:///./krishimitra.db
SECRET_KEY=krishimitra-secure-farming-key-2026

# -------------------------------------------------------------
# Frontend Configuration
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
